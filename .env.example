# ─────────────────────────────────────────────────────────────────────────────
# Silent Rave — environment scaffolding (spec v2.1 — manual bank transfer)
# Copy to .env and fill in real values. .env is gitignored; this file is not.
#
# Secrets marked SERVER-SIDE ONLY must never be shipped to the client bundle
# and must never appear in logs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Postgres — Supabase or direct) — POOLER-READY SPLIT ────────────
# Two URLs, two roles (Prisma ≥5.2 `directUrl` convention; installed 6.19.2):
#
#   DATABASE_URL  → RUNTIME client connections. On Supabase point this at the
#                   TRANSACTION pooler and append ?pgbouncer=true (required:
#                   Prisma's prepared statements are incompatible with
#                   transaction-mode pooling otherwise) plus a small
#                   connection_limit (1 per serverless instance; ~num_cpus*2+1
#                   for a single long-lived Node server).
#   DIRECT_URL    → MIGRATION CLI connections (prisma migrate deploy). MUST be
#                   a DIRECT connection (or Supabase's session pooler): DDL +
#                   advisory locks are not safe through transaction-mode
#                   pgbouncer. The runtime app never reads this variable.
#
# Local dev: point BOTH at the same single Postgres instance — the app only
# reads DATABASE_URL; DIRECT_URL exists solely so the CLI can resolve the
# datasource (a declared-but-unset DIRECT_URL is a hard P1012 CLI error).
#
# ⚠ BEFORE LAUNCH — must be exercised against the REAL pooler (untestable from
# a sandbox): (1) an interactive $transaction callback through DATABASE_URL,
# (2) SELECT ... FOR UPDATE / FOR UPDATE SKIP LOCKED inside that transaction
# (both power the reservation, approval and expiry-sweep paths), (3)
# `prisma migrate deploy` through DIRECT_URL. Prisma documents interactive
# transactions as problematic through transaction-mode poolers; if (1)/(2)
# fail against the transaction pooler, run the app runtime on the session
# pooler or a direct connection instead (keep pgbouncer=true off for direct
# URLs).
DATABASE_URL=postgresql://user:password@pooler.host:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:password@db.host:5432/postgres

# ── Derived buyer status-link tokens (02 v2.1) ───────────────────────────────
# SERVER-SIDE ONLY. The buyer's status token is DERIVED, never stored:
#   base64url(HMAC-SHA256(STATUS_TOKEN_SECRET, order_id ":" status_token_version))
# The email worker derives links at send time from this secret. Rotating it
# invalidates every outstanding status link (bump nothing in the DB — links
# are recomputed on demand). Generate like:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
STATUS_TOKEN_SECRET=

# ── Ticket QR signing — Ed25519 (05-ticketing-and-qr.md) ─────────────────────
# SERVER-SIDE ONLY. TICKET_SIGNING_PRIVATE_KEY is the base64url of the raw
# 32-byte seed; generate BOTH lines with:
#   bun run keygen:ed25519   (scripts/keygen-ed25519.ts)
# Rotation = new key+kid here + the OLD public key in
# TICKET_SIGNING_PUBLIC_KEYS_JSON below so already-minted tickets keep
# verifying; public keys are served to the scanner manifest (03).
TICKET_SIGNING_PRIVATE_KEY=
TICKET_SIGNING_KID=
# Optional, for rotation only: JSON array [{"kid":"sr1-…","publicKey":"<base64url 32B>"}]
# TICKET_SIGNING_PUBLIC_KEYS_JSON=

# ── Private object storage (proof images) ────────────────────────────────────
# Driver: "local" (dev — files under ./.storage-local, HMAC-signed short-lived
# URLs served by /api/admin/storage/object) or "supabase" (documented stub —
# implement per src/lib/storage/supabase.ts before enabling).
# Step 5 plan: .docs/08-hosted-readiness.md. Never use local disk on the host.
STORAGE_DRIVER=local
# SERVER-SIDE ONLY — HMAC key for the local driver's short-lived signed URLs.
STORAGE_SIGNING_SECRET=
SUPABASE_URL=
SUPABASE_STORAGE_SERVER_KEY=
SR_PRIVATE_BUCKET=sr-private
SR_BANNER_BUCKET=sr-banners

# ── Internal job endpoints ───────────────────────────────────────────────────
# SERVER-SIDE ONLY — shared secret for POST /api/internal/expire-holds (the
# hold-expiry sweep). The scheduler (cron job / platform scheduler) sends it
# in the x-cron-secret header; constant-time compared, 401 on mismatch.
CRON_SECRET=

# Email worker (Phase 4)
RESEND_API_KEY=
EMAIL_TRANSPORT=resend
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
PUBLIC_BASE_URL=
EMAIL_SEND_INTERVAL_MS=600
# SERVER-SIDE ONLY: base64url 32 random bytes; encrypts immutable retry payloads.
# No plaintext status tokens/links stored. Keep key until queued jobs finish.
EMAIL_PAYLOAD_SECRET=
# capture is DEV/TEST ONLY. Production refuses missing configuration/capture.
# MAX_EMAIL_ATTEMPTS=6; backoff 1m/5m/30m/2h/6h +/-10% jitter; lease 5m;
# batch cap 20; provider timeout 15s; bounded invocation budget 45s.
# EMAIL_KICK_ENABLED=0 disables only best-effort kicks; every-minute cron required.
# Vercel Hobby only supports daily cron. Planned free external scheduler:
# Cloudflare Workers; setup/deployment require separate approval. Netlify's
# scheduled functions have a 30s limit, shorter than this worker's 45s budget.
# Status links use PUBLIC_BASE_URL/order/:code?t=... (customer page later).

# ── Google Maps Embed ──────────────────────────────────────────────────────
# The key is visible in the iframe URL. Restrict it to the Maps Embed API and
# to HTTP referrers for the site's hostnames. Maps code belongs to a later phase.
GOOGLE_MAPS_EMBED_API_KEY=
GOOGLE_PLACES_API_KEY=

# Step 4 owner Web Push; configure only for the intended host at Step 5.
# Generate with the pinned web-push package; never expose the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Checkout limits (non-secrets) ────────────────────────────────────────────
# Per-IP initialize rate limit per hour (04 default 10). IP is a RATE limit
# only — unresolved-order caps are per email/phone, never per IP (campus NAT).
# INITIALIZE_IP_RATE_LIMIT_PER_HOUR=10

# ── App routing config (not secrets) ─────────────────────────────────────────
# Root domain for subdomain routing (06-auth-and-roles.md):
#   ROOT_DOMAIN          → public customer site
#   admin.ROOT_DOMAIN    → owner dashboard route group
#   staff.ROOT_DOMAIN    → scanner / check-in route group
# Use `localhost` for local development (admin.localhost / staff.localhost).
ROOT_DOMAIN=silentrave.space

# Runtime/auth compatibility. Provider runtime scope only; never commit values.
HOST_PLATFORM=netlify
PROXY_AUTH_SECRET=
NETLIFY_INGRESS_SECRET=
# Same immutable deployment (https://DEPLOY_ID--SITE.netlify.app), not a request host.
AUTH_INTERNAL_BASE_URL=
# Netlify supplies DEPLOY_ID at runtime. Local isolated development uses
# HOST_PLATFORM=local, ROOT_DOMAIN=localhost, PUBLIC_BASE_URL=http://localhost:3000
# and AUTH_INTERNAL_BASE_URL=http://127.0.0.1:<owned server port>.

# ── Origin-check dev relaxation (DEV ONLY — default is STRICT) ───────────────
# Opt IN to relaxed dev Origin rules (06 applies strictly by default, in every
# environment, including dev). With ALLOW_DEV_ORIGIN=1:
#   • admin/staff API surfaces additionally accept the ROOT host
#   • login/logout accept same-origin requests through any host (sandbox
#     preview gateways that serve the app under an external hostname)
# The server REFUSES TO START if this is set while NODE_ENV=production
# (src/instrumentation.ts boot guard). NEVER set it in production.
# ALLOW_DEV_ORIGIN=
